# Prim's Algorithm

graph = [
    [0, 2, 3, 0, 0],
    [2, 0, 1, 4, 0],
    [3, 1, 0, 5, 6],
    [0, 4, 5, 0, 7],
    [0, 0, 6, 7, 0]
]

n = 5
visited = [False] * n

visited[0] = True
total = 0

print("Edges in Minimum Spanning Tree:")

for i in range(n - 1):
    minimum = 9999

    for j in range(n):
        if visited[j]:
            for k in range(n):
                if not visited[k] and graph[j][k] != 0:
                    if graph[j][k] < minimum:
                        minimum = graph[j][k]
                        x = j
                        y = k

    print(x, "-", y, ":", minimum)

    total += minimum
    visited[y] = True

print("Total Cost =", total)
